<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("./partials/head") %>
        <title>Reset Password</title>
</head>

<body>
    <%- include('./partials/nav') %>
        <div id="forgot-container">
            <div id="forgot-card">

                <div id="forgot-header">
                    <h2>Forgot Password?</h2>
                    <p>
                        Enter your registered email address and we'll send you a password reset link.
                    </p>
                </div>

                <form action="/user/forgot-password" method="POST" id="forgot-form">

                    <label for="email">Email Address</label>

                    <input type="email" id="forgot-email" name="email" placeholder="Enter your email" required>

                    <button type="submit" id="forgot-btn">
                        Send Reset Link
                    </button>

                </form>

                <a href="/user/signin" id="forgot-back">
                    ← Back to Login
                </a>

            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <%- include('./partials/scripts') %>
            <% if (success==="1" ) { %>
                <script>
                    document.addEventListener("DOMContentLoaded", function () {

                        Swal.fire({
                            icon: "success",
                            title: "Email Sent",
                            text: "Password reset link has been sent to your email.",
                            confirmButtonText: "OK",

                            customClass: {
                                popup: "login-popup",
                                title: "login-title",
                                confirmButton: "login-btn"
                            }

                        }).then(() => {
                            window.history.replaceState({}, document.title, "/user/forgot-password");
                        });

                    });
                </script>
                <% } %>



</body>

</html>
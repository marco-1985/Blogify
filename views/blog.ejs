<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>Blog App</title>
</head>

<body>
    <%- include('./partials/nav') %>
        <div class="container py-5">

            <!-- Cover Image -->

            <div class="text-center mb-5">

                <a href="<%= blog.coverImageURL %>" target="_blank" rel="noopener noreferrer">
                    <img src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" class="img-fluid rounded shadow"
                        style="max-width: 900px; width: 100%; height: auto; cursor: zoom-in;">
                </a>
            </div>

            <!-- Blog Title -->

            <h1 class="display-5 fw-bold text-center mb-3">

                <%= blog.title %>

            </h1>
            <% if(user && blog.createdBy._id.toString()===user._id){ %>
                <p>User ID: <%= user ? user._id : "Not Logged In" %>
                </p>

                <p>Blog Owner ID: <%= blog.createdBy._id %>
                </p>
                <div class="mt-3 d-flex gap-2">

                    <a href="/blog/edit/<%= blog._id %>" class="btn btn-warning">

                        ✏️ Edit

                    </a>

                    <form action="/blog/delete/<%= blog._id %>" method="POST"
                        onsubmit="return confirm('Are you sure you want to delete this blog?');">

                        <button type="submit" class="btn btn-danger">

                            🗑 Delete

                        </button>

                    </form>

                </div>

                <% } %>
                    <!-- Author -->

                    <div class="d-flex justify-content-center align-items-center mb-5">

                        <img src="<%= blog.createdBy.profileImage %>" class="rounded-circle me-3" width="55" height="55"
                            style="object-fit:cover;">

                        <div>

                            <h6 class="mb-0">

                                <%= blog.createdBy.fullName %>

                            </h6>

                            <small class="text-muted">

                                Published on
                                <%= blog.createdAt.toDateString() %>

                            </small>

                        </div>

                    </div>

                    <!-- Blog Body -->

                    <div class="blog-content">

                        <p>

                            <%= blog.body %>

                        </p>

                    </div>

        </div>
        <div class="container mt-5 mb-5">

            <h3 class="fw-bold mb-4">

                💬 Comments (<%= comments.length %>)

            </h3>

            <% if(locals.user){ %>

                <div class="card shadow-sm border-0 p-4 mb-4">

                    <form action="/blog/comment/<%= blog._id %>" method="POST">

                        <div class="mb-3">

                            <textarea class="form-control" rows="4" name="content" placeholder="Share your thoughts..."
                                required></textarea>

                        </div>

                        <button class="btn btn-primary rounded-pill px-4">

                            Post Comment

                        </button>

                    </form>

                </div>

                <% } %>

                    <% comments.forEach(comment=> { %>

                        <div class="card shadow-sm border-0 mb-3">

                            <div class="card-body">

                                <div class="d-flex align-items-center mb-3">

                                    <img src="<%= comment.createdBy.profileImage %>" class="rounded-circle me-3"
                                        width="50" height="50" style="object-fit:cover;">

                                    <div>

                                        <h6 class="mb-0">

                                            <%= comment.createdBy.fullName %>

                                        </h6>

                                        <small class="text-muted">

                                            <%= comment.createdAt.toDateString() %>

                                        </small>

                                    </div>

                                </div>

                                <p class="mb-0">

                                    <%= comment.content %>

                                </p>

                            </div>

                        </div>

                        <% }) %>

        </div>
        <%- include('./partials/footer') %>
            <%- include('./partials/scripts') %>
</body>

</html>
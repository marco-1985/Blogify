<footer class="footer mt-5">

    <div class="container">

        <div class="row gy-4">

            <!-- Brand Section -->
            <div class="col-lg-4">

                <h3 class="text-white fw-bold">
                    📝 Blogify
                </h3>

                <p class="footer-text">
                    Share your stories, read amazing blogs and connect with developers around the world.
                </p>

                <div class="social-links mt-3">

                    <a href="https://www.linkedin.com/in/karan-kumar-9380b3310/" target="_blank" class="social-link">
                        🔗 LinkedIn
                    </a>

                    <a href="https://github.com/marco-1985" target="_blank" class="social-link">
                        🐙 GitHub
                    </a>

                </div>

            </div>


            <!-- Quick Links -->
            <div class="col-lg-4">

                <h5 class="text-white">
                    Quick Links
                </h5>

                <ul class="list-unstyled mt-3">

                    <li>
                        <a href="/" class="footer-link">
                            Home
                        </a>
                    </li>

                    <li>
                        <a href="<%= locals.user ? '/blog/add-new' : '/user/signin' %>" class="footer-link">
                            Write Blog
                        </a>
                    </li>

                    <li>
                        <a href="/user/signup" class="footer-link">
                            Create Account
                        </a>
                    </li>

                </ul>

            </div>


            <!-- Contact + Form -->
            <div class="col-lg-4">

                <h5 class="text-white">
                    Say Hello 💬
                </h5>


                <p class="footer-text">
                    📧 nicolates1711@gmail.com
                </p>

                <p class="footer-text">
                    📍 Delhi - 110001
                </p>


                <form action="/contact" method="POST" class="mt-3">

                    <input type="email" name="email" class="form-control footer-input mb-2" placeholder="Your Email"
                        required>


                    <textarea name="message" class="form-control footer-input mb-2" rows="3" placeholder="Your Message"
                        required>
    </textarea>


                    <button type="submit" class="btn footer-btn">
                        Send Message
                    </button>

                </form>

            </div>


        </div>


        <hr class="border-secondary my-4">


        <div class="text-center footer-bottom">

            © <%= new Date().getFullYear() %> Blogify | Made by Karan Kumar

        </div>


    </div>

</footer>
      <!-- Floating AI Button -->
    <div id="ai-assistant">
            <div id="chatLauncher" class="chat-target">
                <div id="chatHint">
                    <span id="typingText"></span>
                </div>
                <div id="chatBtn">
                    <img src="/images/chitti.png" alt="Chitti AI">

                </div>

            </div>
        </div>
         <!-- Chat Window -->

        <div id="chatWindow"
            style="display:none;position:fixed;bottom:110px;right:30px;width:370px;height:500px;background:white;border-radius:15px;box-shadow:0 0 15px rgba(0,0,0,.2);overflow:hidden;z-index:9999;">

            <div class="bg-primary text-white p-3 d-flex justify-content-between align-items-center">

                <strong>🤖 Chitti AI</strong>

                <button id="clearChatBtn" class="btn btn-sm btn-light text-dark">
                    🗑 New Chat

<!-- Floating AI Button -->
<div id="ai-assistant">
    <div id="chatLauncher" class="chat-target">
        <div id="chatHint">
            <span id="wave">👋</span>
            <span id="typingText"></span>
        </div>
        <div id="chatBtn">
            <img src="/images/chitti.png" alt="Chitti AI">

        </div>

    </div>
</div>
<!-- Chat Window -->

<div id="chatWindow">
    <div class="bg-primary text-white p-3 d-flex justify-content-between align-items-center">

        <strong>🤖 Chitti AI</strong>

        <button id="clearChatBtn" class="btn btn-sm btn-light text-dark">
            🗑 New Chat
        </button>

    </div>

    <div id="messages">

    </div>

    <div class="p-2 d-flex">

        <input id="messageInput" class="form-control me-2" placeholder="Ask about this blog...">

        <button id="sendBtn" class="btn btn-success">

            Send

        </button>

    </div>

</div>
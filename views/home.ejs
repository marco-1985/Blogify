<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>Blogify</title>
</head>

<body>

    <%- include('./partials/nav') %>

        <!-- Hero Section -->
        <section class="hero-section">
            <div class="container py-5">

                <div class="row align-items-center">

                    <div class="col-lg-6">

                        <span class="badge bg-primary px-3 py-2 mb-3">
                            🚀 Welcome to Blogify
                        </span>

                        <h1 class="display-4 fw-bold">
                            Share Your Ideas With The World
                        </h1>

                        <p class="lead text-muted mt-3">
                            Read amazing blogs from developers and writers or publish your own articles in just a few
                            clicks.
                        </p>

                        <div class="mt-4">

                            <a href="#blogs" class="btn btn-primary btn-lg me-3">
                                Explore Blogs
                            </a>

                            <% if(locals.user){ %>

                                <a href="/blog/add-new" class="btn btn-outline-dark btn-lg">
                                    Write Blog
                                </a>

                                <% } else { %>

                                    <a href="/user/signup" class="btn btn-outline-dark btn-lg">
                                        Get Started
                                    </a>

                                    <% } %>

                        </div>

                    </div>

                    <div class="col-lg-6 text-center">

                        <img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=700"
                            class="img-fluid hero-image rounded-4 shadow" alt="Hero">

                    </div>

                </div>

            </div>
        </section>

        <!-- Blog Section -->

        <section id="blogs" class="py-5">

            <div class="container">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <h2 class="fw-bold mb-1">

                            <% if(search){ %>

                                Search Results

                                <% }else{ %>

                                    Latest Blogs

                                    <% } %>

                        </h2>

                        <p class="text-muted mb-0">

                            <% if(search){ %>

                                Results for
                                <strong>"<%= search %>"</strong>

                                <% }else{ %>

                                    Discover the latest articles from our community.

                                    <% } %>

                        </p>

                    </div>

                    <% if(search){ %>

                        <div class="text-end">

                            <span class="badge bg-primary fs-6">

                                <%= blogs.length %> Results

                            </span>

                            <br>

                            <a href="/" class="btn btn-sm btn-outline-secondary mt-2">

                                ← Back to All Blogs

                            </a>

                        </div>

                        <% } %>

                </div>

                <% if(blogs.length===0){ %>

                    <div class="text-center py-5">

                        <h1 class="display-1">📭</h1>

                        <h3>No Blogs Found</h3>

                        <p class="text-muted">
                            Try searching with another keyword.
                        </p>

                        <a href="/" class="btn btn-primary">
                            Browse All Blogs
                        </a>

                    </div>

                    <% } else { %>

                        <div class="row g-4">

                            <% blogs.forEach(blog=> { %>

                                <div class="col-lg-4 col-md-6">

                                    <div class="card blog-card h-100">

                                        <a href="/blog/<%= blog._id %>">

                                            <img src="<%= blog.coverImageURL %>" class="card-img-top blog-image"
                                                alt="<%= blog.title %>">

                                        </a>

                                        <div class="card-body d-flex flex-column">

                                            <span class="badge bg-primary mb-3">

                                                Blog

                                            </span>

                                            <h5 class="card-title fw-bold">

                                                <%= blog.title %>

                                            </h5>

                                            <div class="mt-auto">

                                                <hr>

                                                <div class="d-flex justify-content-between align-items-center">

                                                    <div>

                                                        <small class="text-muted">

                                                            Published By

                                                        </small>

                                                        <br>

                                                        <strong>

                                                            <%= blog.createdBy ? blog.createdBy.fullName
                                                                : "Unknown Author" %>

                                                        </strong>

                                                    </div>

                                                    <a href="/blog/<%= blog._id %>"
                                                        class="btn btn-primary rounded-pill">

                                                        Read →

                                                    </a>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <% }) %>

                        </div>

                        <% } %>

            </div>

        </section>
        <%- include('./partials/chatbot') %>
            <%- include('./partials/footer') %>
                <%- include('./partials/scripts') %>
                    <script>
                        const BLOG_ID = "";
                    </script>

                    <script src="/js/chatbot.js"></script>
</body>

</html>